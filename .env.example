# Copy values to Railway > your service > Variables. DO NOT commit real secrets.
VULNSCOPE_USERNAME=admin
VULNSCOPE_PASSWORD=REPLACE_WITH_A_UNIQUE_20PLUS_CHARACTER_PASSWORD
VULNSCOPE_DB_PATH=/data/cve_tracking.sqlite3
